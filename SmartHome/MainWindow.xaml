<Window x:Class="SmartHome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartHome.Views"
        Title="스마트홈 통합 관제 시스템"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="600"
        Background="{StaticResource BgPrimary}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── TopBar ── -->
        <Border Grid.Row="0"
                Background="{StaticResource BgTopbar}"
                MouseLeftButtonDown="TopBar_MouseDown">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="스마트홈 통합 관제 시스템"
                           FontSize="13" FontWeight="Medium"
                           FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="16">
                    <!-- Unity 연결 상태 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="WsDot" Width="7" Height="7"
                                 Fill="{StaticResource AccentRed}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="WsStatusText"
                                   Text="Unity 미연결"
                                   FontSize="11" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextDisabled}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 시계 -->
                    <TextBlock x:Name="ClockText"
                               FontSize="12" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>
                    <!-- 최소화 -->
                    <Button Content="─" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextDisabled}"
                            FontFamily="Segoe UI"
                            Click="MinimizeButton_Click" Cursor="Hand"/>
                    <!-- 닫기 -->
                    <Button Content="✕" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextDisabled}"
                            FontFamily="Segoe UI"
                            Click="CloseButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource BorderSub}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10,0,0">

                    <TextBlock Text="공간" FontSize="10" Margin="14,8,0,4"
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource TextHint}"/>

                    <RadioButton Content="현관"  GroupName="Nav" Tag="Entrance"
                                 Style="{StaticResource NavItemStyle}"
                                 IsChecked="True"
                                 Checked="NavItem_Checked"/>
                    <RadioButton Content="거실"  GroupName="Nav" Tag="Living"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="NavItem_Checked"/>
                    <RadioButton Content="주방"  GroupName="Nav" Tag="Kitchen"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="NavItem_Checked"/>
                    <RadioButton Content="안방"  GroupName="Nav" Tag="Bedroom"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="NavItem_Checked"/>
                    <RadioButton Content="욕실"  GroupName="Nav" Tag="Bathroom"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="NavItem_Checked"/>

                    <Separator Margin="14,8" Background="{StaticResource BorderSub}"
                               Height="1" BorderThickness="0"/>

                    <TextBlock Text="시스템" FontSize="10" Margin="14,0,0,4"
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource TextHint}"/>

                    <RadioButton Content="연결"  GroupName="Nav" Tag="Connection"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="NavItem_Checked"/>
                    <RadioButton Content="로그"  GroupName="Nav" Tag="Log"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="NavItem_Checked"/>
                </StackPanel>
            </Border>

            <!-- ── Content Area ── -->
            <ContentControl x:Name="MainContent" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
