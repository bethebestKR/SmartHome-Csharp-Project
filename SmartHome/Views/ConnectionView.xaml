<UserControl x:Class="SmartHome.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimary}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSub}" BorderThickness="0,0,0,1" Padding="16,12,16,8">
            <StackPanel>
                <TextBlock Text="Unity 연결 관리" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="WebSocket 서버 상태 및 실시간 통신 모니터링" FontSize="11" Foreground="{StaticResource TextDisabled}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 콘텐츠 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14" Spacing="10">

                <!-- 연결 상태 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="연결 상태" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Spacing="6">
                            <!-- Unity Client -->
                            <Border x:Name="UnityStatusBorder"
                                    Background="#0A1A0A" BorderBrush="#2E6E2E"
                                    BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Ellipse x:Name="UnityDot" Width="12" Height="12" Fill="{StaticResource AccentRed}"/>
                                        <StackPanel>
                                            <TextBlock Text="Unity Client" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="ws://localhost:8080 · 대기 중" FontSize="10" Foreground="{StaticResource TextDisabled}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="#2A1010" BorderBrush="{StaticResource BorderDanger}"
                                            BorderThickness="1" CornerRadius="4" Padding="10,3">
                                        <TextBlock x:Name="UnityStatusText" Text="WAITING"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource AccentRed}"
                                                   FontFamily="Consolas"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- WPF Server -->
                            <Border Background="#0A1A0A" BorderBrush="#2E6E2E"
                                    BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Ellipse Width="12" Height="12" Fill="{StaticResource AccentGreen}"/>
                                        <StackPanel>
                                            <TextBlock Text="WPF WebSocket 서버" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="포트 8080 · 수신 대기 중" FontSize="10" Foreground="{StaticResource TextDisabled}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="#1A2E1A" BorderBrush="{StaticResource BorderGreen}"
                                            BorderThickness="1" CornerRadius="4" Padding="10,3">
                                        <TextBlock Text="LISTENING" FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource AccentGreen}" FontFamily="Consolas"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 서버 설정 + 패킷 통계 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 서버 설정 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="서버 설정" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Spacing="0">
                                <Grid Margin="0,5"><TextBlock Text="호스트" FontSize="11" Foreground="{StaticResource TextMuted}"/><TextBlock Text="localhost" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                                <Separator Background="{StaticResource BorderSub}" Height="1"/>
                                <Grid Margin="0,5"><TextBlock Text="포트" FontSize="11" Foreground="{StaticResource TextMuted}"/><TextBlock Text="8080" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                                <Separator Background="{StaticResource BorderSub}" Height="1"/>
                                <Grid Margin="0,5"><TextBlock Text="프로토콜" FontSize="11" Foreground="{StaticResource TextMuted}"/><TextBlock Text="WebSocket" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                                <Separator Background="{StaticResource BorderSub}" Height="1"/>
                                <Grid Margin="0,5"><TextBlock Text="데이터 형식" FontSize="11" Foreground="{StaticResource TextMuted}"/><TextBlock Text="JSON" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                                <Separator Background="{StaticResource BorderSub}" Height="1"/>
                                <Grid Margin="0,5"><TextBlock Text="송신 주기" FontSize="11" Foreground="{StaticResource TextMuted}"/><TextBlock Text="100ms" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/></Grid>
                                <Separator Background="{StaticResource BorderSub}" Height="1"/>
                                <Grid Margin="0,5"><TextBlock Text="Ping" FontSize="11" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="PingText" Text="—" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/></Grid>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="서버 재시작"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,3,0" HorizontalAlignment="Stretch"
                                        Click="RestartServer_Click"/>
                                <Button Grid.Column="1" Content="연결 끊기"
                                        Style="{StaticResource DangerButton}"
                                        Margin="3,0,0,0" HorizontalAlignment="Stretch"
                                        Click="Disconnect_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 패킷 통계 + 실시간 패킷 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="패킷 통계" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="8,8" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="SendCount" Text="0" FontSize="20" FontWeight="Medium" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="총 송신" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="8,8" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="RecvCount" Text="0" FontSize="20" FontWeight="Medium" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="총 수신" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="8,8" Margin="4,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="ErrorCount" Text="0" FontSize="20" FontWeight="Medium" Foreground="{StaticResource AccentRed}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="오류" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="실시간 패킷" Style="{StaticResource SectionLabel}"/>
                            <Border Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderSub}"
                                    BorderThickness="1" CornerRadius="4" Padding="10">
                                <ItemsControl x:Name="PacketList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1A2E1A"/>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Direction}" FontSize="9"
                                                               FontFamily="Consolas" Foreground="{StaticResource AccentGreen}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                           FontSize="10" FontFamily="Consolas"
                                                           Foreground="{StaticResource TextMuted}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Time}"
                                                           FontSize="9" Foreground="{StaticResource TextHint}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
