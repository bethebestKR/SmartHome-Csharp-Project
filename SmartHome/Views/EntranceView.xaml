<UserControl x:Class="SmartHome.Views.EntranceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimary}"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="Auto"/>  <!-- 탭 -->
            <RowDefinition Height="*"/>     <!-- 콘텐츠 -->
        </Grid.RowDefinitions>

        <!-- ── 페이지 헤더 ── -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSub}"
                BorderThickness="0,0,0,1" Padding="16,12,16,8">
            <StackPanel>
                <TextBlock Text="현관" FontSize="14" FontWeight="Medium"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="보안 및 환대 — 4개 기능" FontSize="11"
                           Foreground="{StaticResource TextDisabled}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 공간 탭 ── -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderSub}"
                BorderThickness="0,0,0,1" Padding="16,7">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Border Background="#1E3A5F" BorderBrush="#2A4A7F" BorderThickness="1"
                        CornerRadius="4" Padding="11,4">
                    <TextBlock Text="현관" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
                </Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSub}" BorderThickness="1"
                        CornerRadius="4" Padding="11,4">
                    <TextBlock Text="거실" FontSize="11" Foreground="{StaticResource TextDisabled}"/>
                </Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSub}" BorderThickness="1"
                        CornerRadius="4" Padding="11,4">
                    <TextBlock Text="주방" FontSize="11" Foreground="{StaticResource TextDisabled}"/>
                </Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSub}" BorderThickness="1"
                        CornerRadius="4" Padding="11,4">
                    <TextBlock Text="안방" FontSize="11" Foreground="{StaticResource TextDisabled}"/>
                </Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSub}" BorderThickness="1"
                        CornerRadius="4" Padding="11,4">
                    <TextBlock Text="욕실" FontSize="11" Foreground="{StaticResource TextDisabled}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── 콘텐츠 ── -->
        <Grid Grid.Row="2" Margin="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 기능 카드들 -->
            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">

                <!-- 2열 그리드 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 현관 조명 카드 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="현관 조명" Style="{StaticResource CardTitle}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3"
                                        Background="#1A2E1A" BorderBrush="{StaticResource BorderGreen}"
                                        BorderThickness="1" Padding="7,1">
                                    <TextBlock Text="켜짐" FontSize="10" Foreground="{StaticResource AccentGreen}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="자동 감지" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <ToggleButton x:Name="LightAutoToggle"
                                             Style="{StaticResource ToggleStyle}"
                                             HorizontalAlignment="Right"
                                             IsChecked="True"
                                             Checked="LightAuto_Changed"
                                             Unchecked="LightAuto_Changed"/>
                            </Grid>
                            <!-- 밝기 슬라이더 -->
                            <TextBlock Text="밝기" FontSize="10"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,4">
                                <Slider x:Name="BrightnessSlider"
                                        Style="{StaticResource GreenSlider}"
                                        Minimum="0" Maximum="100" Value="70"
                                        ValueChanged="Brightness_Changed"/>
                                <TextBlock Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat={}{0:0}%}"
                                           FontSize="10" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>
                            <!-- 상태 블록 -->
                            <Border Background="#0A1A0A" BorderBrush="{StaticResource AccentGreenDark}"
                                    BorderThickness="2,0,0,0" CornerRadius="0" Padding="8,5">
                                <TextBlock Text="움직임 감지 — 자동 ON" FontSize="10"
                                           Foreground="#7ABB7A"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 침입 감지 카드 (경고 상태) -->
                    <Border Grid.Column="1" Style="{StaticResource DangerCardStyle}" Margin="4,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="보안 / 침입" FontSize="10" Foreground="#AA7070"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3"
                                        Background="#2A1010" BorderBrush="{StaticResource BorderDanger}"
                                        BorderThickness="1" Padding="7,1">
                                    <TextBlock Text="경고" FontSize="10" Foreground="{StaticResource AccentRed}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="침입 감지" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <ToggleButton x:Name="SecurityToggle"
                                             Style="{StaticResource ToggleStyle}"
                                             HorizontalAlignment="Right"
                                             IsChecked="True"/>
                            </Grid>
                            <Border Background="#1A0808" BorderBrush="{StaticResource AccentRed}"
                                    BorderThickness="2,0,0,0" Padding="8,5" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="강제 개방 감지! · 조명 점멸" FontSize="10"
                                               Foreground="{StaticResource AccentRed}"/>
                                    <TextBlock Text="21:28" FontSize="9"
                                               Foreground="#AA5555" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Content="경보 해제" Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="SecurityAlert_Reset"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2열 그리드 2행 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 도어락 카드 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="도어락" Style="{StaticResource CardTitle}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3"
                                        Background="#1F2937" BorderBrush="{StaticResource BorderSub}"
                                        BorderThickness="1" Padding="7,1">
                                    <TextBlock Text="열림" FontSize="10"
                                               Foreground="{StaticResource TextDisabled}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="잠금 상태" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <ToggleButton x:Name="DoorLockToggle"
                                             Style="{StaticResource ToggleStyle}"
                                             HorizontalAlignment="Right"
                                             IsChecked="False"
                                             Checked="DoorLock_Changed"
                                             Unchecked="DoorLock_Changed"/>
                            </Grid>
                            <Border Background="{StaticResource BgDeep}"
                                    BorderBrush="{StaticResource BorderCard}"
                                    BorderThickness="2,0,0,0" Padding="8,5">
                                <TextBlock Text="열림 — 확인 필요" FontSize="10"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 택배 알림 카드 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="택배 알림" Style="{StaticResource CardTitle}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3"
                                        Background="#1A2E1A" BorderBrush="{StaticResource BorderGreen}"
                                        BorderThickness="1" Padding="7,1">
                                    <TextBlock Text="수신 ON" FontSize="10"
                                               Foreground="{StaticResource AccentGreen}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="알림 수신" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <ToggleButton x:Name="ParcelToggle"
                                             Style="{StaticResource ToggleStyle}"
                                             HorizontalAlignment="Right"
                                             IsChecked="True"/>
                            </Grid>
                            <Border Background="#0A1A0A"
                                    BorderBrush="{StaticResource AccentGreenDark}"
                                    BorderThickness="2,0,0,0" Padding="8,5">
                                <TextBlock Text="오늘 1건 도착 · 14:32" FontSize="10"
                                           Foreground="#7ABB7A"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- 오른쪽: 상태 요약 + 통합 알림 -->
            <StackPanel Grid.Column="1" Spacing="8">

                <!-- 상태 요약 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="상태 요약" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Spacing="0">
                            <Grid Margin="0,4">
                                <TextBlock Text="조명" FontSize="10"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="ON · 70%" FontSize="10" FontWeight="Medium"
                                           Foreground="{StaticResource AccentGreen}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="{StaticResource BorderSub}" Height="1"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="침입 감지" FontSize="10"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="경고!" FontSize="10" FontWeight="Medium"
                                           Foreground="{StaticResource AccentRed}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="{StaticResource BorderSub}" Height="1"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="도어락" FontSize="10"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="열림" FontSize="10" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="{StaticResource BorderSub}" Height="1"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="택배" FontSize="10"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="1건" FontSize="10" FontWeight="Medium"
                                           Foreground="{StaticResource AccentGreen}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 통합 알림 (최근 3건) -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="통합 알림 (최근 3건)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Spacing="3">
                            <!-- 경보 알림 -->
                            <Border Background="#1A0808" BorderBrush="{StaticResource AccentRed}"
                                    BorderThickness="2,0,0,0" CornerRadius="4" Padding="8,5">
                                <Grid>
                                    <TextBlock Text="침입 경고 발령" FontSize="10"
                                               Foreground="{StaticResource AccentRed}"/>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="21:28" FontSize="9"
                                                   Foreground="{StaticResource TextHint}"/>
                                        <TextBlock Text="현관" FontSize="9"
                                                   Foreground="{StaticResource TextHint}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- 경보 알림 2 -->
                            <Border Background="#1A0808" BorderBrush="{StaticResource AccentRed}"
                                    BorderThickness="2,0,0,0" CornerRadius="4" Padding="8,5">
                                <Grid>
                                    <TextBlock Text="연기 감지 경보" FontSize="10"
                                               Foreground="{StaticResource AccentRed}"/>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="21:20" FontSize="9"
                                                   Foreground="{StaticResource TextHint}"/>
                                        <TextBlock Text="주방" FontSize="9"
                                                   Foreground="{StaticResource TextHint}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- 일반 알림 -->
                            <Border Background="#0A1A0A" BorderBrush="{StaticResource AccentGreenDark}"
                                    BorderThickness="2,0,0,0" CornerRadius="4" Padding="8,5">
                                <Grid>
                                    <TextBlock Text="택배 도착" FontSize="10"
                                               Foreground="#7ABB7A"/>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="14:32" FontSize="9"
                                                   Foreground="{StaticResource TextHint}"/>
                                        <TextBlock Text="현관" FontSize="9"
                                                   Foreground="{StaticResource TextHint}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
