<UserControl x:Class="SmartHome.Views.LivingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimary}"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSub}" BorderThickness="0,0,0,1" Padding="16,12,16,8">
            <StackPanel>
                <TextBlock Text="거실" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="환경 및 편의 — 6개 기능" FontSize="11" Foreground="{StaticResource TextDisabled}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 탭 -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderSub}" BorderThickness="0,0,0,1" Padding="16,7">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSub}" BorderThickness="1" CornerRadius="4" Padding="11,4">
                    <TextBlock Text="현관" FontSize="11" Foreground="{StaticResource TextDisabled}"/></Border>
                <Border Background="#1E3A5F" BorderBrush="#2A4A7F" BorderThickness="1" CornerRadius="4" Padding="11,4">
                    <TextBlock Text="거실" FontSize="11" Foreground="{StaticResource TextPrimary}"/></Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSub}" BorderThickness="1" CornerRadius="4" Padding="11,4">
                    <TextBlock Text="주방" FontSize="11" Foreground="{StaticResource TextDisabled}"/></Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSub}" BorderThickness="1" CornerRadius="4" Padding="11,4">
                    <TextBlock Text="안방" FontSize="11" Foreground="{StaticResource TextDisabled}"/></Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSub}" BorderThickness="1" CornerRadius="4" Padding="11,4">
                    <TextBlock Text="욕실" FontSize="11" Foreground="{StaticResource TextDisabled}"/></Border>
            </StackPanel>
        </Border>

        <!-- 콘텐츠 -->
        <Grid Grid.Row="2" Margin="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                <!-- 날씨 배너 -->
                <Border Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="10,7">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="맑음 · 외부 28°C" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="날씨 API 연동 — 조도/온도 자동 조절 중" FontSize="10" Foreground="{StaticResource TextDisabled}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#0A1A0A" BorderBrush="{StaticResource BorderGreen}" BorderThickness="1" CornerRadius="3" Padding="8,2">
                            <TextBlock Text="실시간 연동" FontSize="10" Foreground="{StaticResource AccentGreen}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 조명/온도 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 조명 카드 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="조명 / 조도" Style="{StaticResource CardTitle}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3" Background="#1A2E1A" BorderBrush="{StaticResource BorderGreen}" BorderThickness="1" Padding="7,1">
                                    <TextBlock Text="자동" FontSize="10" Foreground="{StaticResource AccentGreen}"/></Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="날씨 연동" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource ToggleStyle}" HorizontalAlignment="Right" IsChecked="True"/>
                            </Grid>
                            <TextBlock Text="밝기" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,6">
                                <Slider x:Name="LightBrightness" Style="{StaticResource GreenSlider}" Minimum="0" Maximum="100" Value="55"/>
                                <TextBlock Text="{Binding ElementName=LightBrightness, Path=Value, StringFormat={}{0:0}%}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>
                            <TextBlock Text="색온도" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                            <Grid>
                                <Slider x:Name="ColorTemp" Style="{StaticResource GreenSlider}" Minimum="2700" Maximum="6500" Value="4200"/>
                                <TextBlock Text="{Binding ElementName=ColorTemp, Path=Value, StringFormat={}{0:0}K}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- 온도 카드 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="온도 / 냉난방" Style="{StaticResource CardTitle}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3" Background="#1A2E1A" BorderBrush="{StaticResource BorderGreen}" BorderThickness="1" Padding="7,1">
                                    <TextBlock Text="냉방" FontSize="10" Foreground="{StaticResource AccentGreen}"/></Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="날씨 연동" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource ToggleStyle}" HorizontalAlignment="Right" IsChecked="True"/>
                            </Grid>
                            <TextBlock Text="목표 온도" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,8">
                                <Slider x:Name="TempTarget" Style="{StaticResource GreenSlider}" Minimum="16" Maximum="30" Value="24"/>
                                <TextBlock Text="{Binding ElementName=TempTarget, Path=Value, StringFormat={}{0:0}°C}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="4,5" Margin="0,0,3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="실내" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="26.5°" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="4,5" Margin="3,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="외부" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="28°" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 미세먼지/공기청정기 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 미세먼지 카드 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="미세먼지 / 창문" Style="{StaticResource CardTitle}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3" Background="#1A2E1A" BorderBrush="{StaticResource BorderGreen}" BorderThickness="1" Padding="7,1">
                                    <TextBlock Text="좋음" FontSize="10" Foreground="{StaticResource AccentGreen}"/></Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="24" FontSize="20" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="μg/m³" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                            </StackPanel>
                            <Border Height="3" CornerRadius="1" Background="{StaticResource BorderSub}" Margin="0,6,0,6">
                                <Border HorizontalAlignment="Left" Width="50" Background="{StaticResource AccentGreenDark}" CornerRadius="1"/>
                            </Border>
                            <Grid Margin="0,0,0,0">
                                <TextBlock Text="창문 자동" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource ToggleStyle}" HorizontalAlignment="Right" IsChecked="True"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- 공기청정기 카드 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="공기청정기" Style="{StaticResource CardTitle}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3" Background="#1A2E1A" BorderBrush="{StaticResource BorderGreen}" BorderThickness="1" Padding="7,1">
                                    <TextBlock Text="가동" FontSize="10" Foreground="{StaticResource AccentGreen}"/></Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="자동 연동" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource ToggleStyle}" HorizontalAlignment="Right" IsChecked="True"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="3" Padding="0,4" Margin="0,0,2,0">
                                    <TextBlock Text="자동" FontSize="10" Foreground="{StaticResource TextDisabled}" HorizontalAlignment="Center"/></Border>
                                <Border Grid.Column="1" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="3" Padding="0,4" Margin="2,0">
                                    <TextBlock Text="1단" FontSize="10" Foreground="{StaticResource TextDisabled}" HorizontalAlignment="Center"/></Border>
                                <Border Grid.Column="2" Background="#1E3A5F" BorderBrush="{StaticResource BorderActive}" BorderThickness="1" CornerRadius="3" Padding="0,4" Margin="2,0">
                                    <TextBlock Text="2단" FontSize="10" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/></Border>
                                <Border Grid.Column="3" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="3" Padding="0,4" Margin="2,0,0,0">
                                    <TextBlock Text="3단" FontSize="10" Foreground="{StaticResource TextDisabled}" HorizontalAlignment="Center"/></Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 모드 카드 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="모드" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="#1E3A5F" BorderBrush="{StaticResource BorderActive}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,3,3">
                                <StackPanel>
                                    <TextBlock Text="일반 모드" FontSize="10" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="기본 유지" FontSize="9" Foreground="{StaticResource TextDisabled}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0,0,3">
                                <StackPanel>
                                    <TextBlock Text="영화 모드" FontSize="10" Foreground="{StaticResource TextDisabled}"/>
                                    <TextBlock Text="조명 OFF" FontSize="9" Foreground="{StaticResource TextHint}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,3,3,0">
                                <StackPanel>
                                    <TextBlock Text="취침 모드" FontSize="10" Foreground="{StaticResource TextDisabled}"/>
                                    <TextBlock Text="전체 절전" FontSize="9" Foreground="{StaticResource TextHint}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,3,0,0">
                                <StackPanel>
                                    <TextBlock Text="절약 모드" FontSize="10" Foreground="{StaticResource TextDisabled}"/>
                                    <TextBlock Text="대기전력 차단" FontSize="9" Foreground="{StaticResource TextHint}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 우측 패널 -->
            <StackPanel Grid.Column="1" Spacing="8">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="상태 요약" Style="{StaticResource SectionLabel}"/>
                        <Grid Margin="0,4"><TextBlock Text="조명" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock Text="ON · 55%" FontSize="10" FontWeight="Medium" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/></Grid>
                        <Separator Background="{StaticResource BorderSub}" Height="1"/>
                        <Grid Margin="0,4"><TextBlock Text="실내온도" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock Text="26.5°C" FontSize="10" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                        <Separator Background="{StaticResource BorderSub}" Height="1"/>
                        <Grid Margin="0,4"><TextBlock Text="목표온도" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock Text="24°C" FontSize="10" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                        <Separator Background="{StaticResource BorderSub}" Height="1"/>
                        <Grid Margin="0,4"><TextBlock Text="PM2.5" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock Text="24 좋음" FontSize="10" FontWeight="Medium" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/></Grid>
                        <Separator Background="{StaticResource BorderSub}" Height="1"/>
                        <Grid Margin="0,4"><TextBlock Text="창문" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock Text="열림" FontSize="10" FontWeight="Medium" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/></Grid>
                        <Separator Background="{StaticResource BorderSub}" Height="1"/>
                        <Grid Margin="0,4"><TextBlock Text="모드" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock Text="일반" FontSize="10" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="통합 알림 (최근 3건)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Spacing="3">
                            <Border Background="#1A0808" BorderBrush="{StaticResource AccentRed}" BorderThickness="2,0,0,0" CornerRadius="4" Padding="8,5">
                                <Grid><TextBlock Text="침입 경고 발령" FontSize="10" Foreground="{StaticResource AccentRed}"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="21:28" FontSize="9" Foreground="{StaticResource TextHint}"/><TextBlock Text="현관" FontSize="9" Foreground="{StaticResource TextHint}"/></StackPanel></Grid>
                            </Border>
                            <Border Background="#1A0808" BorderBrush="{StaticResource AccentRed}" BorderThickness="2,0,0,0" CornerRadius="4" Padding="8,5">
                                <Grid><TextBlock Text="연기 감지 경보" FontSize="10" Foreground="{StaticResource AccentRed}"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="21:20" FontSize="9" Foreground="{StaticResource TextHint}"/><TextBlock Text="주방" FontSize="9" Foreground="{StaticResource TextHint}"/></StackPanel></Grid>
                            </Border>
                            <Border Background="#0A1A0A" BorderBrush="{StaticResource AccentGreenDark}" BorderThickness="2,0,0,0" CornerRadius="4" Padding="8,5">
                                <Grid><TextBlock Text="냉방 가동" FontSize="10" Foreground="#7ABB7A"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="20:10" FontSize="9" Foreground="{StaticResource TextHint}"/><TextBlock Text="거실" FontSize="9" Foreground="{StaticResource TextHint}"/></StackPanel></Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
